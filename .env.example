# Copiar a .env solo dentro de pset_3. No contiene valores utilizables de Snowflake.
MLFLOW_PORT=5001
MLFLOW_TRACKING_URI=http://127.0.0.1:5001
MLFLOW_EXPERIMENT_NAME=pset3_sintetico

# Acceso opcional y explicito; nunca se conecta al importar los modulos.
PSET3_DATA_CLASSIFICATION=SYNTHETIC
PSET3_ALLOWED_DATABASES=PSET3_SINTETICO
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_ROLE=
SNOWFLAKE_WAREHOUSE=
SNOWFLAKE_DATABASE=PSET3_SINTETICO
SNOWFLAKE_SCHEMA=EXPERIMENTOS
SNOWFLAKE_TABLE=OBT_PREDIAL_2B7D72B7735E
# Ruta absoluta de una clave cifrada propia, fuera de pset_3 y pset_2.
SNOWFLAKE_PRIVATE_KEY_PATH=
# Preferir entrada oculta mediante getpass. No escribir passphrase en este archivo.

# Configuracion aprobada por crear; example NO permite entrenar.
PSET3_EXPERIMENT_CONFIG=config/experiment.json
